# Copie para .env (NAO versionar o .env) e preencha:  cp .env.example .env
# Senha do usuario admin do Grafana (acesso so por tunel SSH)
GRAFANA_ADMIN_PASSWORD=troque-esta-senha
# Commit curto da aplicacao (preencha antes do build):  git rev-parse --short HEAD
APP_VERSION=dev
# IP da rede dedicada (cabo) onde o NGINX sera publicado. Sem cabo: IP do Wi-Fi (limitacao declarada)
LAB_BIND_IP=10.10.10.1
# true somente na prova de correlacao (rota /controlled-error); false na campanha
ENABLE_TEST_ROUTES=false
# false apenas no ensaio opcional de custo da telemetria (C0 sem telemetria)
TELEMETRY_ENABLED=true
# collector.yaml (normal) ou collector-debug.yaml (Etapa 4A)
COLLECTOR_CONFIG=collector.yaml

# Rede Docker interna (na reproducao usar subnet/IP diferentes, ex. 172.31.0.0/24 e 172.31.0.10)
LAB_DOCKER_SUBNET=172.30.0.0/24
API_IPV4=172.30.0.10
