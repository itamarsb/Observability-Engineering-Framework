# Limites de validade usados por scripts/revisar_execucoes.py (linha "Validade" do protocol-v1.md).
# Definir ANTES da campanha e congelar junto com o protocolo.
# Cobertura minima da sonda nas fases analisadas (%)
VAL_COBERTURA_SONDA_MIN_PCT=100
# dropped_iterations aceitos nas fases analisadas; acima disso a execucao fica INCONCLUSIVA (revisao manual)
VAL_DROPPED_MAX=0
# CPU maxima do gerador (WSL) nas fases analisadas; acima disso: INCONCLUSIVA (o limite pode ser do gerador)
VAL_CPU_GERADOR_MAX_PCT=85
# Reinicios de conteiner aceitos durante a execucao (OOMKilled sempre invalida)
VAL_REINICIOS_MAX=0
