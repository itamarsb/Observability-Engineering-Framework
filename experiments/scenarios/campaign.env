# Parametros do executor da campanha (scripts/run_campaign.py).
# Valores marcados PILOTO devem ser confirmados nos pilotos e CONGELADOS no protocol-v1.md.

# Ordem dos blocos (repeticao rNN = numero do bloco), conforme experimental-matrix.md
# (C1 retirado do escopo; a ordem relativa dos demais cenarios foi mantida)
BLOCO_1="C0 C2 C3 C4 C5 C6"
BLOCO_2="C2 C4 C6 C3 C0 C5"
BLOCO_3="C5 C3 C6 C0 C2 C4"
# C7 (opcional) roda ao final de cada bloco, pois reinicia a API
INCLUIR_C7=false

# Intervalo minimo entre execucoes (s), contado a partir do fim da anterior
INTERVALO_S=120
# Janela de estado estavel exigida antes de cada execucao (s)
ESTAVEL_S=60
# Novas verificacoes de estabilidade antes de desistir (a cada 30 s)
ESTAVEL_TENTATIVAS=10

# Criterios de estado estavel/seguranca no servidor (secao "Seguranca" do protocolo)
CPU_REPOUSO_MAX_PCT=25          # PILOTO: CPU maxima do servidor em repouso na janela estavel
MEM_DISPONIVEL_MIN_GIB=2
DISCO_LIVRE_MIN_GIB=20
TEMP_MAX_C=                     # PILOTO: vazio = nao verificado (o executor avisa)

# Execucoes invalidadas automaticamente (falha tecnica) sao refeitas no fim do bloco, ate N vezes
REFAZER_FALHAS=1
