# Parametros para a REIMPLANTACAO (Etapa 10): clone em ~/tcc2-repro e projeto Compose tcc2-repro.
# Valores marcados PILOTO devem ser confirmados nos pilotos e CONGELADOS no protocol-v1.md.
PROTOCOL_VERSION=v1-repro
SERVER=itamar@10.10.10.1
SERVER_REPO=tcc2-repro
BASE_URL=http://10.10.10.1:8080
N=20000
# Calcule uma vez: python3 scripts/expected_digest.py 20000
EXPECTED_DIGEST=b8e7c92320f2bcd4365ebfe78b8ea6901477135536232c823eba2c44ccb70a7e
WARMUP_S=60
PHASE_S=180
HTTP_TIMEOUT=2s
PRE_VUS=50
MAX_VUS=100
PROBE_INTERVAL_S=5
PROBE_TIMEOUT_S=2
MAX_CLOCK_OFFSET_S=1.0
RUNS_DIR=runs
# Projeto do Compose no servidor (tcc2; na reimplantacao da Etapa 10: tcc2-repro)
COMPOSE_PROJECT=tcc2-repro
